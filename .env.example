# DevNews v2. Copy to .env (pipeline) and web/.env.local (site). Both are gitignored.
# Everything below runs on free tiers.

# ── Pipeline: python -m agent ────────────────────────────────────────────────
# Primary model provider; the other one is the automatic fallback.
LLM_PROVIDER=gemini

# aistudio.google.com/apikey
GEMINI_API_KEY=
# console.groq.com/keys
GROQ_API_KEY=
# Optional model overrides.
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b

# Supabase → Settings → API. The service key bypasses RLS: pipeline and server code only.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Optional. Raises the GitHub search rate limit (Actions provides one automatically).
GITHUB_TOKEN=

# Optional morning email via resend.com (free: 3,000/month). Skipped unless both are set.
RESEND_API_KEY=
EMAIL_FROM=DevNews <briefing@your-domain.com>
# Where the site lives, for links in email.
SITE_URL=http://localhost:3000

# ── Site: web/.env.local ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OAuth buttons to show: google | github | facebook | azure. Each must be enabled in
# Supabase too. Facebook additionally needs a Meta app pointed at /privacy and
# /data-deletion. Leave empty for email and password only, which needs no setup.
NEXT_PUBLIC_AUTH_PROVIDERS=
# Shown on the privacy and data-deletion pages. Optional; those pages work without it.
# NEXT_PUBLIC_CONTACT_EMAIL=
# Server only. The one model call the site makes: reading the description of their work a
# reader writes during setup, once, to fill in topics and technologies. Same keys as the
# pipeline, same fallback order; without them setup still works and the reader picks by
# hand. Copy GEMINI_API_KEY / GROQ_API_KEY (and optionally LLM_PROVIDER) from above.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# The public URL of the site, for OAuth and password-reset redirects. Optional on Vercel,
# where the request host is used; set it when a proxy or custom domain sits in front.
# NEXT_PUBLIC_SITE_URL=https://devnews.example.com
# Server only, never NEXT_PUBLIC_: the private RSS feed looks up tokens with it, and signup
# uses it to confirm a new account if the project still has "Confirm email" switched on.
# SUPABASE_SERVICE_KEY=
# Development only: render the site from agent/fixtures data, with no Supabase at all.
# DEVNEWS_FIXTURES=1

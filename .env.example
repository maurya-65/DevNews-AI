# Copy to .env and fill in. .env is gitignored — never commit it.
# No paid API: both LLM providers run on their free tier.
# See PROGRESS.md decisions 17-19 for why Anthropic was dropped.

# ── LLM provider ─────────────────────────────────────────────────────────────
# Which provider select.py uses: gemini | groq
# Not a secret — safe to set as a plain env var in the Actions workflow.
LLM_PROVIDER=gemini

# aistudio.google.com/apikey → Create API key. Free, no card. Format: AIza...
GEMINI_API_KEY=

# console.groq.com/keys → Create API Key. Free, no card. Format: gsk_...
GROQ_API_KEY=

# ── Supabase: agent (Phase 2) ────────────────────────────────────────────────
# Settings → Data API → Project URL. No trailing slash.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Settings → API Keys → service_role (secret)
# ⚠️ Bypasses RLS. Agent + GitHub Actions only. NEVER in web/ or any NEXT_PUBLIC_ var.
SUPABASE_SERVICE_KEY=

# ── Supabase: web (Phase 4) ──────────────────────────────────────────────────
# Same URL as above — Next.js needs the NEXT_PUBLIC_ prefix to expose it.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Settings → API Keys → anon (public). Goes to the browser; RLS must be on before deploy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Web: auth ────────────────────────────────────────────────────────────────
# Which OAuth buttons the login page shows: google | github | azure (Microsoft).
# Comma separated, no spaces. A provider listed here must also be enabled in
# Supabase → Authentication → Sign In / Providers, or its button will error.
# Email + password always works and needs no dashboard setup.
# Confirmation email must be OFF: Authentication → Sign In / Providers → Email
# → uncheck "Confirm email". Signing up returns a session immediately.
NEXT_PUBLIC_AUTH_PROVIDERS=google,github,azure

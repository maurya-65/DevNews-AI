# DevNews v2. Copy to .env (pipeline) and web/.env.local (site). Both are gitignored.
# Everything below runs on free tiers.

# ── Pipeline: python -m agent ────────────────────────────────────────────────
# Primary model provider; the other one is the automatic fallback.
LLM_PROVIDER=gemini

# aistudio.google.com/apikey
GEMINI_API_KEY=
# console.groq.com/keys
GROQ_API_KEY=
# Optional model overrides.
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b

# Supabase → Settings → API. The service key bypasses RLS: pipeline and server code only.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Optional. Raises the GitHub search rate limit (Actions provides one automatically).
GITHUB_TOKEN=

# Optional morning email via resend.com (free: 3,000/month). Skipped unless both are set.
RESEND_API_KEY=
EMAIL_FROM=DevNews <briefing@your-domain.com>
# Where the site lives, for links in email.
SITE_URL=http://localhost:3000

# ── Site: web/.env.local ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OAuth buttons to show: google | github | azure. Each must be enabled in Supabase too.
NEXT_PUBLIC_AUTH_PROVIDERS=github,google
# Server only: used by the private RSS feed route to look up a feed token.
# SUPABASE_SERVICE_KEY=
# Development only: render the site from agent/fixtures data, with no Supabase at all.
# DEVNEWS_FIXTURES=1
